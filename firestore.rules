rules_version = '2';
// Ord 2. Читати спільний контент можуть лише користувачі, що увійшли через Google.
// Створювати можуть лише власні записи з білого списку полів і з обмеженнями розміру. Редагувати чужі записи не можна, власні лише видаляти.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function optStr(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }

    match /content/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','kind','title','no','uk','explain','top','bottom','svg','q','sj','lvl','provider','model','tier','createdAt','v'])
        && request.resource.data.keys().hasAll(['uid','kind','provider','model','tier','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.kind in ['story','fact','joke','meme','image','video']
        && request.resource.data.provider in ['anthropic','openai','gemini','deepseek','openrouter']
        && request.resource.data.tier in ['paid','free']
        && request.resource.data.model is string && request.resource.data.model.size() <= 80
        && optStr(request.resource.data, 'title', 120)
        && optStr(request.resource.data, 'no', 1500)
        && optStr(request.resource.data, 'uk', 1500)
        && optStr(request.resource.data, 'explain', 500)
        && optStr(request.resource.data, 'top', 80)
        && optStr(request.resource.data, 'bottom', 80)
        && optStr(request.resource.data, 'q', 120)
        && optStr(request.resource.data, 'svg', 7000)
        && optStr(request.resource.data, 'sj', 6000)
        && optStr(request.resource.data, 'lvl', 2);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Скарги: можна лише створювати, читати зможе лише власник проєкту в консолі
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','contentId','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.contentId is string && request.resource.data.contentId.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Прогрес користувача: бачить і змінює лише він сам
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data','updated'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 950000
        && request.resource.data.updated == request.time;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
